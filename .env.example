# ============================================================
# local-orchestra - ornek ortam degiskenleri
# Kopyalayin:  Copy-Item .env.example .env   (Windows PowerShell)
#              cp .env.example .env          (bash)
# Kural: UCRETLI modeller YALNIZCA Jev icin (OpenRouter).
# Tum roller EVREN AI uzerinden calisir; son yedek OpenRouter ":free".
# ============================================================

# --- EVREN AI (SSB/SAYZEK ulusal LLM gecidi) - birincil saglayici ---
# OpenAI-uyumlu: https://evren-llmapi.ssyz.org.tr/v1
EVREN_LLM_API_KEY=

# --- OpenRouter (JEV - TypeSafe System One + ucretsiz yedekler) ---
OPENROUTER_API_KEY=

# --- NVIDIA NIM (KULLANILMIYOR - EVREN'e gecildi; acil geri donus icin saklandi) ---
NVIDIA_API_KEY=
# Ek NIM anahtarlari (ayni katalog; rate-limit/failover icin)
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# --- Google Gemini (su an kullanilmiyor; aday olarak duruyor) ---
GEMINI_API_KEY=

# --- Groq (opsiyonel) - hizli router/brain/council/decider/judge yedekleri ---
# GROQ_API_KEY=

# --- Kullanilmiyor ---
# Jev artik OPENROUTER_API_KEY kullanir; JEV_AI_API_KEY okunmuyor.
# JEV_AI_API_KEY=

# --- Medya / OCR ---
# Windows OCR gömülüdür (ücretsiz, çevrimdışı). Dil paketi gerekirse:
#   Add-WindowsCapability -Online -Name "Language.OCR~~~tr-TR~0.0.1.0"
# Çalışma alanı dışındaki klasörleri okumaya izin ver (os.pathsep ile ayır):
# ORCHESTRA_MEDIA_ROOTS=C:\Users\<kullanici>\Downloads;C:\Users\<kullanici>\Desktop
